<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_food_waste_reason_list" model="ir.ui.view">
        <field name="name">food.waste.reason.list</field>
        <field name="model">food.waste.reason</field>
        <field name="arch" type="xml">
            <list string="Waste Reasons">
                <field name="name"/>
                <field name="type"/>
            </list>
        </field>
    </record>

    <record id="view_food_waste_reason_form" model="ir.ui.view">
        <field name="name">food.waste.reason.form</field>
        <field name="model">food.waste.reason</field>
        <field name="arch" type="xml">
            <form string="Waste Reason">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_food_waste_reason" model="ir.actions.act_window">
        <field name="name">Reasons</field>
        <field name="res_model">food.waste.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_food_waste_reason" 
              name="Reasons" 
              parent="food_waste_manager.menu_food_waste_config" 
              action="action_food_waste_reason" 
              sequence="20"/>
</odoo>
