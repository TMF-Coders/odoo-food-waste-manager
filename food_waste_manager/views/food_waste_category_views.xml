<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_food_waste_category_list" model="ir.ui.view">
        <field name="name">food.waste.category.list</field>
        <field name="model">food.waste.category</field>
        <field name="arch" type="xml">
            <list string="Waste Categories">
                <field name="name"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="view_food_waste_category_form" model="ir.ui.view">
        <field name="name">food.waste.category.form</field>
        <field name="model">food.waste.category</field>
        <field name="arch" type="xml">
            <form string="Waste Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="color" widget="color"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_food_waste_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">food.waste.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_food_waste_category" 
              name="Categories" 
              parent="food_waste_manager.menu_food_waste_config" 
              action="action_food_waste_category" 
              sequence="10"/>
</odoo>
