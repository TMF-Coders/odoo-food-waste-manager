<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_food_waste_record_list" model="ir.ui.view">
        <field name="name">food.waste.record.list</field>
        <field name="model">food.waste.record</field>
        <field name="arch" type="xml">
            <list string="Food Waste Records">
                <field name="name"/>
                <field name="date"/>
                <field name="product_id"/>
                <field name="category_id" optional="show"/>
                <field name="reason_id"/>
                <field name="qty"/>
                <field name="uom_id"/>
                <field name="cost" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_food_waste_record_form" model="ir.ui.view">
        <field name="name">food.waste.record.form</field>
        <field name="model">food.waste.record</field>
        <field name="arch" type="xml">
            <form string="Food Waste Record">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="product_id"/>
                            <field name="category_id"/>
                            <field name="reason_id"/>
                        </group>
                        <group>
                            <label for="qty"/>
                            <div class="o_row">
                                <field name="qty" class="oe_inline"/>
                                <field name="uom_id" class="oe_inline"/>
                            </div>
                            <field name="cost" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional details..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_food_waste_record_pivot" model="ir.ui.view">
        <field name="name">food.waste.record.pivot</field>
        <field name="model">food.waste.record</field>
        <field name="arch" type="xml">
            <pivot string="Waste Analysis">
                <field name="date" type="col"/>
                <field name="category_id" type="row"/>
                <field name="reason_id" type="row"/>
                <field name="cost" type="measure"/>
                <field name="qty" type="measure"/>
            </pivot>
        </field>
    </record>
    
    <record id="view_food_waste_record_graph" model="ir.ui.view">
        <field name="name">food.waste.record.graph</field>
        <field name="model">food.waste.record</field>
        <field name="arch" type="xml">
            <graph string="Waste Analysis" type="bar">
                <field name="reason_id"/>
                <field name="cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_food_waste_record" model="ir.actions.act_window">
        <field name="name">Waste Records</field>
        <field name="res_model">food.waste.record</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <menuitem id="menu_food_waste_record_action" 
              name="All Records" 
              parent="food_waste_manager.menu_food_waste_records" 
              action="action_food_waste_record" 
              sequence="10"/>
</odoo>
