<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Categories -->
        <record id="module_category_food_waste" model="ir.module.category">
            <field name="name">Food Waste</field>
            <field name="description">Helps you manage your food waste tracking.</field>
            <field name="sequence">20</field>
        </record>

        <!-- Groups -->
        <record id="group_food_waste_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_food_waste"/>
        </record>

        <record id="group_food_waste_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_food_waste"/>
            <field name="implied_ids" eval="[(4, ref('group_food_waste_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="food_waste_record_comp_rule" model="ir.rule">
            <field name="name">Food Waste Record multi-company</field>
            <field name="model_id" ref="model_food_waste_record"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
